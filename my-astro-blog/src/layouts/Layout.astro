---
import Toolbar from "../components/Toolbar.astro"
import Bootstrap from "../components/Bootstrap.astro";
import Style from "../assets/css/none.css?url";
const { title = "rkgk / root" } = Astro.props;

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/rkgk_palette.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href={Style}>
		<title>{title}</title>
	</head>
	<body>
		<Toolbar transition:persist></Toolbar>
		<slot />
		<Bootstrap></Bootstrap>
	</body>
</html>
