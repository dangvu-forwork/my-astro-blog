---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = await getCollection('blog');
---

<Layout>
	<main>
		<h1>Notes on building better software</h1>
		<p class="intro">Practical ideas for calmer systems and more thoughtful developer tools.</p>
		{posts.map((post) => (
			<article>
				<p>{post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long' })}</p>
				<h2><a href={`/posts/${post.id}`}>{post.data.title}</a></h2>
				<p>{post.data.description}</p>
			</article>
		))}
	</main>
</Layout>

<style>
	main {
		max-width: 760px;
		margin: 0 auto;
		padding: 5rem 1.25rem;
	}

	h1 {
		max-width: 620px;
		margin: 0;
		font-size: clamp(2.75rem, 8vw, 5rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.intro {
		max-width: 540px;
		margin: 1.25rem 0 4rem;
		font-size: 1.2rem;
		line-height: 1.6;
		color: #53645d;
	}

	article {
		padding: 1.5rem 0;
		border-top: 1px solid #cbd5d1;
	}

	article p {
		margin: 0;
		color: #53645d;
	}

	article h2 {
		margin: 0.4rem 0;
		font-size: 1.8rem;
	}

	a {
		color: #245b43;
	}
</style>
