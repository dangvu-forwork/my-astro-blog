<div id="topnav" class="bg-tint is-open">
    <button id="topnav-open" type="button" aria-label="Toggle navigation" aria-expanded="false" class="bg-tint">
        <p>&lt;</p> <!-- i had to use &lt to display the element < safely without error -->
    </button>
    <ul class="topnav-buttons">
        <img src="/rkgk_nav.png" id="nav-img">
        <li class="dropdown">
            <button class="dropbtn">homepage!</button>
            <div class="dropdown-content">
                <a href="/">main!</a>
                <a href="/content/intro">about...</a>
                <a href="/content/policy">policy?</a>
            </div>
        </li>
    </ul>
</div>

<script>
    const topnav = document.querySelector<HTMLElement>("#topnav");
    const topnavOpen = document.querySelector<HTMLButtonElement>("#topnav-open");
    const topnavOpenTxt = topnavOpen?.querySelector<HTMLElement>("p");

    if (topnav && topnavOpen && topnavOpenTxt) { // if both exist
        topnavOpen.addEventListener("click", () => {
            const isOpen = topnav.classList.toggle("is-open");
            topnavOpen.setAttribute("aria-expanded", String(isOpen));

            const setText = isOpen ? "<" : ">";
            
            topnavOpenTxt.innerHTML = setText;
        });
    }
</script>

<style>
    /* separate style for the dropdown so its easier to go back and edit */

    /* Dropdown Button */
    .dropbtn {
        background-color: inherit;
        color: black;
        padding: 16px;
        font-size: 16px;
        width: 100%;
        height: 100%;

        border: none;
        /* just to make the text centered */
        display: flex;
        justify-content: center;
        align-items: center ;   
    }

    /* The container <div> - needed to position the dropdown content */
    .dropdown {
        position: relative;
        display: inline-block;
        width: 100%;
        height: 100%;
    }

    /* Dropdown Content (Hidden by Default) */
    .dropdown-content {
        display: none;
        position: absolute;
        background-color: #f1f1f1;
        min-width: 160px;
        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
        left:100%;
        top: 0vh;
    }

    /* Links inside the dropdown */
    .dropdown-content a {
        color: black;
        padding: 12px 16px;
        text-decoration: none;
        display: block;
    }

    /* Change color of dropdown links on hover. Placeholder, will add something special later. */
    .dropdown-content a:hover {background-color: #ddd;}

    .dropdown:hover {z-index: 11 !important;} /* necessary important tag here. */
    .dropdown:hover .dropdown-content {display: block}

    .dropdown:hover .dropbtn {background-color: var(--primary-interact);}
</style>

<style>
    #nav-img {
        width: 100%;
        height: 27vh;
    }

    #topnav {
        position: fixed;
        display: flex;
        justify-content: flex-end;
        align-items: flex-start;

        width: 15vw;
        height: 100%;
        min-height: 100%;
        z-index: 10; /* making sure its on top of every element. */
        padding-right: 3px;

        animation: close;
        animation-fill-mode: forwards;
        animation-timing-function: step-start;
    }

    #topnav::after {
        position: absolute;
        content: "";
        border-right: solid var(--primary-bd-color);
        height: 90vh;
        width: 100%;

        top:10vh;
        left: 0%; /* I have no clue why, but if i remove this the border is just messed up */
        padding: 0;
    }

    #topnav-open {
        content: "";
        width: 10%;
        height: 10vh;
        left: 100%;

        display: block;
        position: absolute;
        background-color: inherit;

        border:         solid var(--primary-bd-color);
        border-left:    none;
        border-top:     none;
    }

    #topnav-open:active {
        background-color: var(--primary-interact);
    }

    #topnav.is-open {
        animation: opening;
        animation-timing-function: step-start;
        animation-fill-mode: forwards;
    }

    .topnav-buttons {
        width: 100%;
        height: 100%;
        padding: 0;
        margin: 0;
        z-index: inherit;
    }

    .topnav-buttons li{
        list-style: none;
        height: 40px;
        margin-bottom: 10px;
        z-index: inherit; 
        position: relative;

        border: none;
        border-bottom: 2px solid var(--primary-bd-color);
    }
/* 
    .topnav-buttons li:hover {
        z-index: 11;
    } */

    .topnav-buttons li a {
        color: black;
        text-decoration: none;
        
        display: flex;
        align-items: center;
        justify-content: center;
        
        font-family: Myungjo-Bold;
        border: none;
        border-bottom: 2px solid var(--primary-bd-color);
    }

    @keyframes opening {
        from { transform: translateX(-100%); }
        to { transform: translateX(0); }
    }

    @keyframes close {
        from { transform: translateX(0); }
        to { transform: translateX(-100%); }
    }
</style>